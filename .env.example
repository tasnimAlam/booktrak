# Copy to .env. Compose reads it automatically.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bookshelf
# One DB login per service (created on first DB start)
AUTH_DB_PASSWORD=change-me
BOOKS_DB_PASSWORD=change-me
# Long random string. Generate one with: openssl rand -hex 32
# The placeholder is too short on purpose: the server refuses to start until you replace it.
JWT_SECRET=change-me
